{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3DSFERA",
  "version": "0.1.0",
  "identifier": "app.3dsfera.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @3dsfera/web run dev",
    "beforeBuildCommand": "pnpm --filter @3dsfera/web run build"
  },
  "app": {
    "windows": [
      {
        "title": "3DSFERA",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; child-src 'self' blob:; connect-src 'self' data: blob: http://localhost:4000 https://api.3dsfera.app ws://localhost:5173; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Russian", "English"]
      }
    },
    "copyright": "3DSFERA",
    "category": "Business",
    "shortDescription": "Товар в действии — до покупки"
  }
}
