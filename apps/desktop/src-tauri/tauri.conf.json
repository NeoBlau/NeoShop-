{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3DSFERA",
  "version": "0.1.0",
  "identifier": "app.3dsfera.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @3dsfera/web run dev",
    "beforeBuildCommand": "pnpm --filter @3dsfera/web run build"
  },
  "app": {
    "windows": [
      {
        "title": "3DSFERA",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' http://localhost:4000 ws://localhost:5173; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
