{
  "name": "3dsfera",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @3dsfera/shared build && pnpm --filter @3dsfera/api build && pnpm --filter @3dsfera/web build",
    "dev": "pnpm --filter @3dsfera/shared build && pnpm --parallel --filter @3dsfera/shared --filter @3dsfera/api --filter @3dsfera/web dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "prettier": "^3.7.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
