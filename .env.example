# ---------------------------------------------------------------------------
# 3DSFERA — local development environment
# Copy to .env (`make env`) and adjust if you changed docker-compose ports.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://sfera:sfera@localhost:5432/sfera?schema=public

# --- API ------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Origin(s) allowed to call the API with credentials, comma separated.
WEB_ORIGIN=http://localhost:5173,tauri://localhost
# 32+ random bytes. Generate: openssl rand -base64 48
SESSION_SECRET=dev-only-secret-change-me-0000000000000000000
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# --- S3 / MinIO -----------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sfera-assets
S3_ACCESS_KEY=sfera
S3_SECRET_KEY=sfera-secret
S3_FORCE_PATH_STYLE=true
# Public base URL that user-uploaded files are served from. Keep it on a
# different host than the app in production (see docs/architecture.md).
ASSET_PUBLIC_URL=http://localhost:9000/sfera-assets

# --- Mail (mailpit in dev, catches everything) ----------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="3DSFERA <no-reply@3dsfera.local>"

# --- Payments -------------------------------------------------------------
# Leave empty to use the built-in mock provider (works fully offline).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Web (Vite, must be prefixed with VITE_) ------------------------------
VITE_API_URL=http://localhost:4000
